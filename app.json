{
  "expo": {
    "name": "Mazal",
    "slug": "mazal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "mazal",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1B3E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mazal.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Mazal needs access to your camera to take profile photos.",
        "NSPhotoLibraryUsageDescription": "Mazal needs access to your photos to add them to your profile.",
        "NSLocationWhenInUseUsageDescription": "Mazal uses your location to show you nearby matches.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Mazal uses your location to show you nearby matches.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mazal.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1B3E"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Mazal uses your location to show you nearby matches."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Mazal needs access to your photos to add them to your profile.",
          "cameraPermission": "Mazal needs access to your camera to take profile photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C9A227"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3550432802315468~9124654238",
          "iosAppId": "ca-app-pub-3550432802315468~7292697810"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ade3b671-1a13-46ce-a9ec-61d86e3671dd"
      }
    },
    "owner": "itaiwins"
  }
}
