# =========================================
# Mazal - Environment Configuration
# =========================================
# Copy this file to .env and fill in your values
# Never commit the .env file to version control!

# -----------------------------------------
# REQUIRED: Supabase Configuration
# -----------------------------------------
# Get these from your Supabase project dashboard:
# https://supabase.com/dashboard/project/_/settings/api

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# -----------------------------------------
# OPTIONAL: RevenueCat In-App Purchases
# -----------------------------------------
# Get these from RevenueCat dashboard:
# https://app.revenuecat.com/

EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# -----------------------------------------
# OPTIONAL: Google Maps (Android only)
# -----------------------------------------
# Get this from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Enable "Maps SDK for Android" for your project

EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# -----------------------------------------
# OPTIONAL: Sentry Error Tracking
# -----------------------------------------
# Get this from your Sentry project settings:
# https://sentry.io/

EXPO_PUBLIC_SENTRY_DSN=

# -----------------------------------------
# App Environment
# -----------------------------------------
# Values: development, staging, production

EXPO_PUBLIC_APP_ENV=development

# -----------------------------------------
# Feature flags (see docs/ROADMAP.md)
# -----------------------------------------
# All default to OFF. Only the exact string "true" turns a feature on.
# Orthodox Shidduch mode: (orthodox*) + (shidduch*) routes and their entry points.
# Parents/grandparents "Safta" mode: (safta*) routes, the Safta tab, badges and copy.
# Photo verification: the "Verify Your Profile" action and app/profile/verify.tsx.
#   Do NOT turn this one on. It is off because there is no honest way to decide the badge
#   on the device, and `users.is_verified` is service_role-only since migration 00024
#   (MEXA-359), so the flow would fail with a 42501 even if you did. It comes back with the
#   Rekognition Edge Function.
# "See who likes you": the Likes screen, its entry point and badge on the Matches tab, and
#   the three places the paywall promises the feature - this flag gates the promise as well
#   as the feature. Turning it on needs migration 00026 applied to the project the build
#   points at (without it the two RPCs are 404s) and Lelouch's sign-off, because it is a
#   user-visible feature on a paid tier. The Gold gate is on the device only until MEXA-373.

EXPO_PUBLIC_FEATURE_ORTHODOX_MODE=false
EXPO_PUBLIC_FEATURE_SAFTA_MODE=false
EXPO_PUBLIC_FEATURE_PHOTO_VERIFICATION=false
EXPO_PUBLIC_FEATURE_WHO_LIKES_YOU=false

# -----------------------------------------
# Ads (see docs/ROADMAP.md)
# -----------------------------------------
# "true" serves Google's reserved test ad units instead of Mazal's real AdMob
# units. Keep it "true" for every build we hand to a tester: real ads in our own
# builds are invalid traffic and can get the AdMob account suspended.
# Pinned to "true" in all three eas.json profiles. Only the public App Store
# release flips it to false, and that needs Itai's sign-off.

EXPO_PUBLIC_USE_TEST_ADS=true
