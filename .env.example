# =========================================
# Mazal - Environment Configuration
# =========================================
# Copy this file to .env and fill in your values
# Never commit the .env file to version control!

# -----------------------------------------
# REQUIRED: Supabase Configuration
# -----------------------------------------
# Get these from your Supabase project dashboard:
# https://supabase.com/dashboard/project/_/settings/api

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# -----------------------------------------
# OPTIONAL: RevenueCat In-App Purchases
# -----------------------------------------
# Get these from RevenueCat dashboard:
# https://app.revenuecat.com/

EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# -----------------------------------------
# OPTIONAL: Google Maps (Android only)
# -----------------------------------------
# Get this from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Enable "Maps SDK for Android" for your project

EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# -----------------------------------------
# OPTIONAL: Sentry Error Tracking
# -----------------------------------------
# Get this from your Sentry project settings:
# https://sentry.io/

EXPO_PUBLIC_SENTRY_DSN=

# -----------------------------------------
# App Environment
# -----------------------------------------
# Values: development, staging, production

EXPO_PUBLIC_APP_ENV=development

# -----------------------------------------
# Feature flags (see docs/ROADMAP.md)
# -----------------------------------------
# Both default to OFF. Only the exact string "true" turns a feature on.
# Orthodox Shidduch mode: (orthodox*) + (shidduch*) routes and their entry points.
# Parents/grandparents "Safta" mode: (safta*) routes, the Safta tab, badges and copy.

EXPO_PUBLIC_FEATURE_ORTHODOX_MODE=false
EXPO_PUBLIC_FEATURE_SAFTA_MODE=false
